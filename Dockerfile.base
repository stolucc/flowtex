# FlowTex base image — rebuild only when upgrading Node or TeX Live
# Build:  docker build -f Dockerfile.base -t flowtex-base .
FROM texlive/texlive:latest

# texlive/texlive already includes TeX Live full + common tools
# Just add Node.js and git
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    git \
    && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

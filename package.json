{
  "name": "flowtex",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "cd server && node --env-file=../.env index.js",
    "dev:client": "cd client && npx vite",
    "build": "cd client && npx vite build"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "happy-dom": "^20.8.9",
    "vitest": "^4.1.3"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "otpauth": "^9.5.0",
    "playwright": "^1.59.1",
    "qrcode": "^1.5.4"
  }
}

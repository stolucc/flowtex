{
  "name": "flowtex",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "cd server && node --env-file=../.env index.js",
    "dev:client": "cd client && npx vite",
    "build": "cd client && npx vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test --workers=1",
    "e2e:ui": "playwright test --ui",
    "e2e:chromium": "playwright test --project=chromium --workers=1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint/js": "^9.39.4",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^25.9.2",
    "bcryptjs": "^3.0.3",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-security": "^4.0.0",
    "globals": "^17.5.0",
    "happy-dom": "^20.8.9",
    "ioredis": "^5.10.1",
    "pg": "^8.20.0",
    "playwright": "^1.59.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.3"
  },
  "overrides": {
    "shell-quote": "^1.8.4"
  }
}

{
  "name": "flowtex-client",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/build-docs.mjs",
    "build": "VITE_BUILD_SHA=$(git rev-parse --short HEAD 2>/dev/null || echo dev) VITE_BUILD_TIME=$(date -u +%FT%TZ) vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:mutation": "stryker run"
  },
  "dependencies": {
    "@codemirror/language": "^6.10.0",
    "@codemirror/legacy-modes": "^6.4.0",
    "@codemirror/state": "^6.4.0",
    "@codemirror/view": "^6.34.0",
    "@vitejs/plugin-react": "^6.0.1",
    "codemirror": "^6.0.1",
    "pdfjs-dist": "^5.7.284",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "typo-js": "^1.3.1",
    "y-codemirror.next": "^0.3.5",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.31"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "happy-dom": "^20.8.9",
    "marked": "^18.0.4",
    "vite": "^8.0.3",
    "vitest": "^4.1.2"
  },
  "overrides": {
    "qs": "^6.15.2"
  }
}

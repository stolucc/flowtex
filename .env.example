# ── Database (PostgreSQL) ──────────────────────────────────────────────
PGDATABASE=flowtex
PGHOST=localhost
PGPORT=5432
# PGUSER=
# PGPASSWORD=

# ── Server ────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ── Session ───────────────────────────────────────────────────────────
# REQUIRED in production — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=flowtex-dev-secret-change-in-production

# ── Encryption key for GitHub tokens at rest ──────────────────────────
# REQUIRED in production — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# ── CORS ──────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3001

# ── GitHub OAuth (optional — enables GitHub sync) ────────────────────
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# ── SMTP (optional — enables email verification, password reset) ─────
# Can also be configured via Admin Dashboard > Settings
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@example.com

# ── App URL (used in emails) ─────────────────────────────────────────
# APP_URL=https://your-domain.com
# ADMIN_EMAIL=admin@example.com

# ── Redis (optional — enables WebSocket horizontal scaling) ───────────
# REDIS_URL=redis://localhost:6379

# ── Logging ───────────────────────────────────────────────────────────
# LOG_LEVEL=debug  # trace, debug, info, warn, error, fatal

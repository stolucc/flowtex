# ── Database (PostgreSQL) ──────────────────────────────────────────────
PGDATABASE=flowtex
PGHOST=localhost
PGPORT=5432
# PGUSER=
# PGPASSWORD=

# ── Server ────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ── Session ───────────────────────────────────────────────────────────
# REQUIRED — leave blank to force a deliberate value. Generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# The server refuses to start in production if this is empty OR matches
# the known sample value below.
SESSION_SECRET=

# ── Encryption key for GitHub tokens at rest ──────────────────────────
# REQUIRED in production — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# ── CORS ──────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3001

# ── GitHub OAuth (optional — enables GitHub sync) ────────────────────
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# ── SMTP (optional — enables email verification, password reset) ─────
# Can also be configured via Admin Dashboard > Settings
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM: address shown in the From: header. Either a bare email
# (server auto-prepends "FlowTex" so clients display the friendly name)
# or include your own display name explicitly, e.g.:
#   SMTP_FROM=FlowTex Support <noreply@example.com>
# SMTP_FROM=noreply@example.com

# ── App URL (used in emails) ─────────────────────────────────────────
# APP_URL=https://your-domain.com
# ADMIN_EMAIL=admin@example.com

# ── Redis (optional — enables WebSocket horizontal scaling) ───────────
# REDIS_URL=redis://localhost:6379

# ── Logging ───────────────────────────────────────────────────────────
# LOG_LEVEL=debug  # trace, debug, info, warn, error, fatal

# ── LaTeX compile resource limits (Linux only, requires util-linux) ──
# When prlimit is available, the compile process is wrapped with these
# kernel-level resource caps. On macOS / non-Linux these are ignored.
# Defaults are sized for typical academic documents; raise if you see
# legitimate compiles failing with "killed by signal" in the log.
# COMPILE_RLIMIT_AS_BYTES=2147483648    # 2 GB virtual memory
# COMPILE_RLIMIT_FSIZE_BYTES=104857600  # 100 MB max single output file
# COMPILE_RLIMIT_NPROC=64               # max subprocesses (latexmk + helpers)

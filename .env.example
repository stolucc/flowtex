# ── Database (PostgreSQL) ──────────────────────────────────────────────
PGDATABASE=underleaf
PGHOST=localhost
PGPORT=5432
# PGUSER=
# PGPASSWORD=

# ── Server ────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ── Session ───────────────────────────────────────────────────────────
# REQUIRED in production — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=flowtex-dev-secret-change-in-production

# ── Encryption key for GitHub tokens at rest ──────────────────────────
# REQUIRED in production — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# ── CORS ──────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3001

# ── Redis (optional — enables WebSocket horizontal scaling) ───────────
# REDIS_URL=redis://localhost:6379

# ── Logging ───────────────────────────────────────────────────────────
# LOG_LEVEL=debug  # trace, debug, info, warn, error, fatal
